# =============================================================================
# KubanFy — Environment Variables
# Copy to .env and fill values. NEVER commit real secrets.
# =============================================================================

# Environment: development | test | staging | production
ENVIRONMENT=development
DEBUG=true

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://kubanfy:kubanfy@localhost:5432/kubanfy
DATABASE_URL_SYNC=postgresql://kubanfy:kubanfy@localhost:5432/kubanfy

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible)
# -----------------------------------------------------------------------------
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_CACHE_BUCKET=kubanfy-cache
R2_PERMANENT_BUCKET=kubanfy-permanent
R2_REGION=auto

# Local/dev fallback (MinIO)
# R2_ENDPOINT=http://localhost:9000
# R2_ACCESS_KEY_ID=minioadmin
# R2_SECRET_ACCESS_KEY=minioadmin

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48

# -----------------------------------------------------------------------------
# Sessions / Devices
# -----------------------------------------------------------------------------
MAX_DEVICES_PER_USER=5
MAX_CONCURRENT_SESSIONS=3
SESSION_IDLE_TIMEOUT_MINUTES=60

# -----------------------------------------------------------------------------
# Cache / TTL (hours)
# -----------------------------------------------------------------------------
CACHE_TTL_LOW_DEMAND_HOURS=36
CACHE_TTL_MEDIUM_DEMAND_HOURS=72
CACHE_TTL_HIGH_DEMAND_HOURS=168
CACHE_SINGLE_FLIGHT_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Audio / Quality
# -----------------------------------------------------------------------------
AUDIO_LOW_BITRATE_KBPS=128
AUDIO_MEDIUM_BITRATE_KBPS=256
QUALIFIED_PLAY_SECONDS=30
MAX_UPLOAD_SIZE_MB=100
ALLOWED_AUDIO_EXTENSIONS=mp3,flac,wav,m4a,aac,ogg

# -----------------------------------------------------------------------------
# Rate limits (requests per minute)
# -----------------------------------------------------------------------------
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_SEARCH=60
RATE_LIMIT_DOWNLOAD=20
RATE_LIMIT_PREVIEW=30
RATE_LIMIT_UPLOAD=10

# -----------------------------------------------------------------------------
# Geo
# -----------------------------------------------------------------------------
DEFAULT_COUNTRY=CU
GEOIP_DB_PATH=
TRUSTED_PROXY_IPS=

# -----------------------------------------------------------------------------
# Feature flags (comma-separated or individual)
# -----------------------------------------------------------------------------
FEATURE_ARTIST_PUBLISHING=true
FEATURE_MONETIZATION=false
FEATURE_GOOGLE_PLAY=false
FEATURE_MAINTENANCE_MODE=false
FEATURE_PROVIDER_YOUTUBE=false

# -----------------------------------------------------------------------------
# Email (optional in early stages)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=smtp | resend | brevo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@kubanfy.local
RESEND_API_KEY=
BREVO_API_KEY=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@kubanfy.local
SUPER_ADMIN_PASSWORD=change-me-immediately

# -----------------------------------------------------------------------------
# Provider credentials (leave empty = UNAVAILABLE)
# -----------------------------------------------------------------------------
# PROVIDER_X_API_KEY=
# PROVIDER_X_SECRET=
