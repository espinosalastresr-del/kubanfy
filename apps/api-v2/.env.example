ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://kubanfy:change-me@localhost:5432/kubanfy_auth_v2
DATABASE_URL_SYNC=postgresql+psycopg://kubanfy:change-me@localhost:5432/kubanfy_auth_v2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_NAME=kubanfy_session
SESSION_REMEMBER_DAYS=30
SESSION_SHORT_HOURS=12
TRUST_CLOUDFLARE_HEADERS=false
TERMS_VERSION=draft-pending-v1
REGISTRATION_ENABLED=true

# Keep these empty until a transactional email provider is selected.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
AUTH_WEB_URL=
PASSWORD_RESET_MINUTES=30
