{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "kubanfy-api-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "KubanFyApiContainer",
      "image": "../../../apps/api/Dockerfile",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "KUBANFY_API_CONTAINER", "class_name": "KubanFyApiContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["KubanFyApiContainer"] }
  ]
}
