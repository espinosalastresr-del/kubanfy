{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kubanfy-api-staging",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "KubanFyApiContainer",
      "image": "../../../apps/api/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KUBANFY_API_CONTAINER",
        "class_name": "KubanFyApiContainer"
      }
    ]
  },
  "exports": {
    "KubanFyApiContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "DEBUG": "false",
    "DEFAULT_COUNTRY": "CU",
    "RATE_LIMIT_FAIL_OPEN": "true",
    "LOG_LEVEL": "INFO",
    "LOG_FORMAT": "json",
    "FEATURE_MONETIZATION": "false",
    "FEATURE_GOOGLE_PLAY": "false",
    "FEATURE_PROVIDER_YOUTUBE": "false",
    "R2_REGION": "auto",
    "R2_CACHE_BUCKET": "kubanfy-cache-staging",
    "R2_PERMANENT_BUCKET": "kubanfy-permanent-staging",
    "R2_ENDPOINT": "https://71f97aca36ff6c3e9dc13d6b30549271.r2.cloudflarestorage.com",
    "CORS_ORIGINS": "https://kubanfy-web-staging.workers.dev",
    "ALLOWED_HOSTS": "kubanfy-api-staging.workers.dev"
  }
}
