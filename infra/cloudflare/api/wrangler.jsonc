{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kubanfy-api-staging",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-14",
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "KubanFyApiContainer",
      "image": "../../../apps/api/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 3
    },
    {
      "class_name": "KubanFyJobRunner",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "../../../apps/api/Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KUBANFY_API_CONTAINER",
        "class_name": "KubanFyApiContainer"
      },
      {
        "name": "KUBANFY_JOB_RUNNER",
        "class_name": "KubanFyJobRunner"
      }
    ]
  },
  "exports": {
    "KubanFyApiContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "KubanFyJobRunner": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "DEBUG": "false",
    "DEFAULT_COUNTRY": "CU",
    "RATE_LIMIT_FAIL_OPEN": "true",
    "LOG_LEVEL": "INFO",
    "LOG_FORMAT": "json",
    "FEATURE_MONETIZATION": "false",
    "FEATURE_GOOGLE_PLAY": "false",
    "FEATURE_PROVIDER_YOUTUBE": "false",
    "EMAIL_PROVIDER": "resend",
    "EMAIL_FROM": "KubanFy <onboarding@resend.dev>",
    "FRONTEND_BASE_URL": "https://kubanfy-web-staging.globumlatinmusic.workers.dev",
    "R2_REGION": "auto",
    "R2_CACHE_BUCKET": "kubanfy-cache-staging",
    "R2_PERMANENT_BUCKET": "kubanfy-permanent-staging",
    "R2_ENDPOINT": "https://692849a1e51eea43c2ddbf3cddc42f6f.r2.cloudflarestorage.com",
    "R2_SIGNED_URL_EXPIRY_SECONDS": "900",
    "CORS_ORIGINS": "https://kubanfy-web-staging.globumlatinmusic.workers.dev",
    "ALLOWED_HOSTS": "kubanfy-api-staging.globumlatinmusic.workers.dev"
  }
}
